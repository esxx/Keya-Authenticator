    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera wird benötigt, um beim Hinzufügen von 2FA-Konten QR-Codes zu scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access is needed to scan QR codes when adding 2FA accounts."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita acceso a la cámara para escanear códigos QR al agregar cuentas 2FA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à la caméra est nécessaire pour scanner les QR codes lors de l'ajout de comptes 2FA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2FAアカウントを追加するときにQRコードをスキャンするため、カメラへのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2FA 계정을 추가할 때 QR 코드를 스캔하려면 카메라 접근 권한이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessário acesso à câmera para escanear QR codes ao adicionar contas 2FA."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к камере нужен, чтобы сканировать QR-коды при добавлении аккаунтов 2FA."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加 2FA 账户时，需要访问相机以扫描二维码。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Face ID entsperren Sie Keya Authenticator, ohne jedes Mal Ihre PIN einzugeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID lets you unlock Keya Authenticator without entering your PIN every time."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID te permite desbloquear Keya Authenticator sin ingresar tu PIN cada vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID vous permet de déverrouiller Keya Authenticator sans saisir votre PIN à chaque fois."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face IDを使うと、毎回PINを入力しなくてもKeya Authenticatorのロックを解除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID를 사용하면 매번 PIN을 입력하지 않고도 Keya Authenticator의 잠금을 해제할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Face ID permite desbloquear o Keya Authenticator sem digitar seu PIN toda vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С Face ID можно открывать Keya Authenticator, не вводя каждый раз PIN-код."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用面容 ID 解锁 Keya Authenticator，无需每次输入 PIN 码。"
          }
        }
      }
    },
