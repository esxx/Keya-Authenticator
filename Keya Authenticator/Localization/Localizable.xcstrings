    "There are no tokens to export. Add at least one token first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keine Tokens zum Exportieren. Fügen Sie zuerst mindestens einen hinzu."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay tokens para exportar. Agrega al menos un token primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun jeton à exporter. Ajoutez d'abord au moins un jeton."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクスポートするトークンがありません。まず少なくとも1つのトークンを追加してください"
