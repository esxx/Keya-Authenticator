        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存备份。请检查可用存储空间后重试。"
          }
        }
      }
    },
    "The backup is encrypted with AES-256-GCM. Enter the password used when it was exported." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Backup ist mit AES-256-GCM verschlüsselt. Geben Sie das Passwort ein, das Sie beim Export festgelegt haben."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
