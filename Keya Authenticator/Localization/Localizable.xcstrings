    "Backup your tokens regularly to avoid losing access to your accounts": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup your tokens regularly to avoid losing access to your accounts"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz copias de seguridad de tus tokens regularmente para evitar perder acceso a tus cuentas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegardez vos jetons régulièrement pour éviter de perdre l'accès à vos comptes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントへのアクセスを失わないように、定期的にトークンをバックアップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 접근권을 잃지 않도록 토큰을 정기적으로 백업하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça backup dos seus tokens regularmente para evitar perder o acesso às suas contas"
          }
        }
      }
    },
