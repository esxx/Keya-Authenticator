    "·" : {

    },
    "%@ doesn't have permission to use %@. Tap 'Open Settings' to allow it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ darf %2$@ nicht verwenden. Tippen Sie auf „Einstellungen öffnen“, um es zu erlauben."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no tiene permiso para usar %2$@. Toca “Abrir Configuración” para permitirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n'a pas l'autorisation d'utiliser %2$@. Touchez « Ouvrir les Réglages » pour l'autoriser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@には%2$@を使用する権限がありません。「設定を開く」をタップして許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에 %2$@ 사용 권한이 없습니다. ‘설정 열기’를 탭하여 허용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ não tem permissão para usar %2$@. Toque em “Abrir Ajustes” para permitir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложению %1$@ не разрешено использовать %2$@. Нажмите «Открыть настройки», чтобы дать разрешение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 没有使用%2$@ 的权限。轻点“打开设置”即可允许。"
          }
        }
      }
    },
    "%@ is not available right now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist gerade nicht verfügbar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está disponible en este momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'est pas disponible pour le moment."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在%@は利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 %@을(를) 사용할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está disponível no momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ сейчас недоступен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 暂时不可用。"
          }
        }
      }
    },
    "%@ is not set up on this device. Go to iOS Settings → %@ & Passcode to enroll." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist auf diesem Gerät nicht eingerichtet. Richten Sie es unter „Einstellungen“ → „%2$@ & Code“ ein."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no está configurado en este dispositivo. Ve a Configuración de iOS → %2$@ y código para configurarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n'est pas configuré sur cet appareil. Allez dans Réglages iOS → %2$@ et code pour l'activer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでは%1$@が設定されていません。iOSの「設定」→「%2$@とパスコード」で登録してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에 %1$@이(가) 설정되어 있지 않습니다. iOS 설정 → %2$@ 및 암호에서 등록하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ não está configurado neste dispositivo. Acesse Ajustes do iOS → %2$@ e Código para configurá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ не настроен на этом устройстве. Настроить его можно в разделе «Настройки» → «%2$@ и код-пароль»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备尚未设置%1$@。请前往“设置”→“%2$@ 与密码”进行设置。"
          }
        }
      }
    },
