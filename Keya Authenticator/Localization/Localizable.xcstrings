{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "%@ doesn't have permission to use %@. Tap 'Open Settings' to allow it." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no tiene permiso para usar %2$@. Toca “Abrir Ajustes” para permitirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n'a pas l'autorisation d'utiliser %2$@. Touchez « Ouvrir les Réglages » pour l'autoriser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@には%2$@を使用する権限がありません。「設定を開く」をタップして許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에 %2$@ 사용 권한이 없습니다. ‘설정 열기’를 탭하여 허용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ não tem permissão para usar %2$@. Toque em “Abrir Configurações” para permitir."
          }
        }
      }
    },
    "%@ is not available right now." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está disponible en este momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'est pas disponible pour le moment."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在%@は利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 %@을(를) 사용할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está disponível no momento."
          }
        }
      }
    },
    "%@ is not set up on this device. Go to iOS Settings → %@ & Passcode to enroll." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no está configurado en este dispositivo. Ve a Ajustes de iOS → %2$@ y código para configurarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n'est pas configuré sur cet appareil. Allez dans Réglages iOS → %2$@ et code pour l'activer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでは%1$@が設定されていません。iOSの設定 → %2$@とパスコードで登録してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에 %1$@이(가) 설정되어 있지 않습니다. iOS 설정 → %2$@ 및 암호에서 등록하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ não está configurado neste dispositivo. Acesse Configurações do iOS → %2$@ e Código para configurá-lo."
          }
        }
      }
    },
    "%lld tokens are already in your vault and were kept as they are." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld token is already in your vault and was kept as it is."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tokens are already in your vault and were kept as they are."
                }
              }
            }
          }
        },
        "es-419" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld token ya está en tu bóveda y se conservó tal como estaba."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tokens ya están en tu bóveda y se conservaron tal como estaban."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld jeton est déjà dans votre coffre et a été conservé tel quel."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld jetons sont déjà dans votre coffre et ont été conservés tels quels."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld個のトークンはすでに保管庫にあるため、そのまま保持されました。"
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld개의 토큰은 이미 보관함에 있어 그대로 유지되었습니다."
                }
              }
            }
          }
        },
        "pt-BR" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld token já está no seu cofre e foi mantido como estava."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tokens já estão no seu cofre e foram mantidos como estavam."
                }
              }
            }
          }
        }
      }
    },
    "%lld tokens could not be imported because the data was missing or invalid. The remaining tokens were imported successfully." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld token could not be imported because the data was missing or invalid.\nThe remaining tokens were imported successfully."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tokens could not be imported because the data was missing or invalid.\nThe remaining tokens were imported successfully."
                }
              }
            }
          }
        },
        "es-419" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld token no pudo importarse porque los datos faltaban o eran inválidos.\nLos tokens restantes se importaron correctamente."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tokens no pudieron importarse porque los datos faltaban o eran inválidos.\nLos tokens restantes se importaron correctamente."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld jeton n'a pas pu être importé car les données étaient manquantes ou invalides.\nLes jetons restants ont été importés avec succès."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld jetons n'ont pas pu être importés car les données étaient manquantes ou invalides.\nLes jetons restants ont été importés avec succès."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "データが見つからないか無効なため、%lld個のトークンをインポートできませんでした。\n残りのトークンは正常にインポートされました。"
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "데이터가 없거나 유효하지 않아 %lld개의 토큰을 가져오지 못했습니다.\n나머지 토큰은 성공적으로 가져왔습니다."
                }
              }
            }
          }
        },
        "pt-BR" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld token não pôde ser importado porque os dados estavam ausentes ou inválidos.\nOs tokens restantes foram importados com sucesso."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tokens não puderam ser importados porque os dados estavam ausentes ou inválidos.\nOs tokens restantes foram importados com sucesso."
                }
              }
            }
          }
        }
      }
    },
    "A device passcode is required to use %@. Set one in iOS Settings → %@ & Passcode." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita un código del dispositivo para usar %1$@. Configura uno en Ajustes de iOS → %2$@ y código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un code d'appareil est nécessaire pour utiliser %1$@. Définissez-en un dans Réglages iOS → %2$@ et code."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@を使用するにはデバイスのパスコードが必要です。iOSの設定 → %2$@とパスコードで設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@을(를) 사용하려면 기기 암호가 필요합니다. iOS 설정 → %2$@ 및 암호에서 설정하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessário um código do dispositivo para usar %1$@. Defina um em Configurações do iOS → %2$@ e Código."
          }
        }
      }
    },
    "A PIN already exists. Please try again." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe un PIN. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un code PIN existe déjà. Veuillez réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PINはすでに設定されています。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN이 이미 설정되어 있습니다. 다시 시도해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já existe um PIN. Tente novamente."
          }
        }
      }
    },
    "Authenticate to access your 2FA codes." : {
      "comment" : "Biometric / passcode prompt shown by the AutoFill extension",
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentícate para acceder a tus códigos 2FA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifiez-vous pour accéder à vos codes 2FA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2FAコードにアクセスするには認証してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2FA 코드에 접근하려면 인증하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentique-se para acessar seus códigos 2FA."
          }
        }
      }
    },
    "Authentication cancelled" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autenticación cancelada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentification annulée"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認証がキャンセルされました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인증이 취소되었습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autenticação cancelada"
          }
        }
      }
    },
    "Biometric authentication failed" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La autenticación biométrica falló"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de l'authentification biométrique"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生体認証に失敗しました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생체 인증에 실패했습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha na autenticação biométrica"
          }
        }
      }
    },
    "Biometric authentication is locked. Please unlock your device with your passcode and try again." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La autenticación biométrica está bloqueada. Desbloquea tu dispositivo con tu código e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'authentification biométrique est verrouillée. Déverrouillez votre appareil avec votre code, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生体認証がロックされています。パスコードでデバイスのロックを解除してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생체 인증이 잠겼습니다. 기기 암호로 잠금을 해제한 후 다시 시도해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A autenticação biométrica está bloqueada. Desbloqueie o dispositivo com seu código e tente novamente."
          }
        }
      }
    },
    "Biometric authentication is not available" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La autenticación biométrica no está disponible"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'authentification biométrique n'est pas disponible"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生体認証は利用できません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생체 인증을 사용할 수 없습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A autenticação biométrica não está disponível"
          }
        }
      }
    },
    "Biometric database changed. Please authenticate with PIN first." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos biométricos cambiaron. Primero autentícate con tu PIN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données biométriques ont changé. Authentifiez-vous d'abord avec votre code PIN."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生体認証データが変更されました。まずPINで認証してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생체 인식 정보가 변경되었습니다. 먼저 PIN으로 인증해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados biométricos mudaram. Primeiro, autentique-se com seu PIN."
          }
        }
      }
    },
    "Camera access denied. Enable it in Settings > Privacy & Security > Camera." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceso a la cámara denegado. Actívalo en Ajustes > Privacidad y seguridad > Cámara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès à la caméra refusé. Activez-le dans Réglages > Confidentialité et sécurité > Appareil photo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラへのアクセスが拒否されました。設定 > プライバシーとセキュリティ > カメラで許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라 접근이 거부되었습니다. 설정 > 개인정보 보호 및 보안 > 카메라에서 허용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acesso à câmera negado. Ative-o em Configurações > Privacidade e Segurança > Câmera."
          }
        }
      }
    },
    "Camera access is required to scan QR codes. Enable it in Settings." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita acceso a la cámara para escanear códigos QR. Actívalo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à la caméra est nécessaire pour scanner les QR codes. Activez-le dans Réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QRコードをスキャンするにはカメラへのアクセスが必要です。設定で許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR 코드를 스캔하려면 카메라 접근 권한이 필요합니다. 설정에서 허용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessário acesso à câmera para escanear QR codes. Ative-o em Configurações."
          }
        }
      }
    },
    "Confirm to enable %@ unlock" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirma para activar el desbloqueo con %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmez pour activer le déverrouillage par %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
