          }
        }
      }
    },
    "The backup couldn't be saved. Check your available storage and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Backup konnte nicht gespeichert werden. Prüfen Sie den freien Speicher und versuchen Sie es erneut."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia de seguridad no pudo guardarse. Comprueba el almacenamiento disponible e intenta de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sauvegarde n'a pas pu être enregistrée. Vérifiez l'espace disponible et réessayez."
