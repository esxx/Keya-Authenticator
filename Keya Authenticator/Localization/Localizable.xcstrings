        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업을 저장할 수 없습니다. 사용 가능한 저장 공간을 확인하고 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
