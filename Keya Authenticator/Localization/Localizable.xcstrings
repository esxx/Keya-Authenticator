        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 잠금 해제를 켜려면 확인하세요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirme para ativar o desbloqueio com %@"
          }
        }
      }
    },
