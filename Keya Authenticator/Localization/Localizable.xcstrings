                }
              }
            }
          }
        }
      }
    },
    "%lld tokens could not be imported because the data was missing or invalid. The remaining tokens were imported successfully." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Token konnte nicht importiert werden, weil Daten fehlten oder ungültig waren.\nAlle anderen Tokens wurden importiert."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Tokens konnten nicht importiert werden, weil Daten fehlten oder ungültig waren.\nAlle anderen Tokens wurden importiert."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld token could not be imported because the data was missing or invalid.\nThe remaining tokens were imported successfully."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tokens could not be imported because the data was missing or invalid.\nThe remaining tokens were imported successfully."
                }
              }
            }
          }
        },
        "es-419" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld token no pudo importarse porque los datos faltaban o eran inválidos.\nLos tokens restantes se importaron correctamente."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tokens no pudieron importarse porque los datos faltaban o eran inválidos.\nLos tokens restantes se importaron correctamente."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld jeton n'a pas pu être importé car les données étaient manquantes ou invalides.\nLes jetons restants ont été importés avec succès."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld jetons n'ont pas pu être importés car les données étaient manquantes ou invalides.\nLes jetons restants ont été importés avec succès."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "データが見つからないか無効なため、%lld個のトークンをインポートできませんでした。\n残りのトークンは正常にインポートされました。"
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "데이터가 없거나 유효하지 않아 %lld개의 토큰을 가져오지 못했습니다.\n나머지 토큰은 성공적으로 가져왔습니다."
                }
              }
            }
          }
        },
        "pt-BR" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld token não pôde ser importado porque os dados estavam ausentes ou inválidos.\nOs tokens restantes foram importados com sucesso."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tokens não puderam ser importados porque os dados estavam ausentes ou inválidos.\nOs tokens restantes foram importados com sucesso."
                }
              }
            }
          }
        },
        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld токена не удалось импортировать: данные отсутствуют или повреждены.\nОстальные токены импортированы."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld токенов не удалось импортировать: данные отсутствуют или повреждены.\nОстальные токены импортированы."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld токен не удалось импортировать: данные отсутствуют или повреждены.\nОстальные токены импортированы."
                }
