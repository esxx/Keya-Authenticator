    "AES-256-GCM with PBKDF2. Password is required to export — keep it safe.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AES-256-GCM with PBKDF2. Password is required to export — keep it safe."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "AES-256-GCM con PBKDF2. Se requiere contraseña para exportar — manténgala segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AES-256-GCM avec PBKDF2. Un mot de passe est requis pour l'export — gardez-le en lieu sûr."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PBKDF2を使用したAES-256-GCM。エクスポートにはパスワードが必要です — 安全に保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PBKDF2를 사용한 AES-256-GCM. 내보내기에 비밀번호가 필요합니다 — 안전하게 보관하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "AES-256-GCM com PBKDF2. Uma senha é necessária para exportar — mantenha-a em segurança"
          }
        }
      }
    },
