          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업은 AES-256-GCM으로 암호화되어 있습니다. 내보낼 때 사용한 비밀번호를 입력하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
