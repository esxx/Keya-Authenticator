    "%lld tokens are already in your vault and were kept as they are." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Token ist bereits in Ihrem Tresor und bleibt unverändert."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Tokens sind bereits in Ihrem Tresor und bleiben unverändert."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld token is already in your vault and was kept as it is."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tokens are already in your vault and were kept as they are."
                }
              }
            }
          }
        },
        "es-419" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld token ya está en tu bóveda y se conservó tal como estaba."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tokens ya están en tu bóveda y se conservaron tal como estaban."
                }
