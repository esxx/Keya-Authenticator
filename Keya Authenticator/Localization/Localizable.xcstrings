    },
    "Your tokens will be encrypted with AES-256-GCM. You'll need this password to import the backup.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tokens se cifrarán con AES-256-GCM. Necesitarás esta contraseña para importar el respaldo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos jetons seront chiffrés avec AES-256-GCM. Vous aurez besoin de ce mot de passe pour importer la sauvegarde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンはAES-256-GCMで暗号化されます。バックアップをインポートするにはこのパスワードが必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰이 AES-256-GCM으로 암호화됩니다. 백업을 가져오려면 이 비밀번호가 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus tokens serão criptografados com AES-256-GCM. Você precisará desta senha para importar o backup."
          }
        }
      }
    },
