    "Your support keeps Keya Authenticator independent and ad-free. It genuinely makes a difference.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu apoyo mantiene Keya Authenticator independiente y sin anuncios. Genuinamente marca la diferencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre soutien maintient Keya Authenticator indépendant et sans publicités. Cela fait vraiment la différence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのサポートがKeya Authenticatorを独立的で広告なしに保ちます。本当に大きな違いをもたらします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러분의 지원이 Keya Authenticator를 독립적이고 광고 없이 유지합니다. 정말로 큰 차이를 만듭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu apoio mantém o Keya Authenticator independente e sem anúncios. Isso realmente faz a diferença."
          }
        }
      }
    },
    "Your tokens have been saved to a JSON file": {
      "localizations": {
        "es-419": {
