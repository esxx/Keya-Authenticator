    "%lld token%@ could not be imported because the data was missing or invalid. The remaining tokens were imported successfully.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld token%2$@ could not be imported because the data was missing or invalid. The remaining tokens were imported successfully"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld token%2$@ no pudo importarse porque los datos faltaban o eran inválidos. Los tokens restantes se importaron correctamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld jeton%2$@ n'a pas pu être importé car les données étaient manquantes ou invalides. Les jetons restants ont été importés avec succès."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データが見つからないか無効なため、%1$lld個のトークン%2$@をインポートできませんでした。残りのトークンは正常にインポートされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터가 없거나 유효하지 않아 %1$lld개의 토큰%2$@을 가져오지 못했습니다. 나머지 토큰은 성공적으로 가져왔습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld token%2$@ não pôde ser importado porque os dados estavam ausentes ou inválidos. Os tokens restantes foram importados com sucesso."
          }
        }
      }
    },
